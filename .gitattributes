# Force LF line endings for shell scripts and Dockerfiles regardless of
# the operator's git core.autocrlf setting. Docker's build context uses
# working-tree files, not git blobs — a Windows checkout with CRLF would
# break the alpine `/bin/sh` shebang on `entrypoint.sh`.
*.sh text eol=lf
Dockerfile text eol=lf

# Embedded chassis text assets are read raw via go:embed and verified by
# byte-exact substring tests (see internal/chassis/css_scope_test.go).
# Force LF so Windows checkouts don't fail those tests when core.autocrlf
# converts CRLF on checkout.
internal/chassis/static/*.css text eol=lf
internal/chassis/static/*.js text eol=lf
internal/chassis/templates/*.html text eol=lf

# The sidecar manifest is parsed field-by-field by scripts/fetch-sidecars.sh.
# A CRLF checkout appends \r to the last column (output), so ffmpeg.exe becomes
# "ffmpeg.exe\r": the *.exe case fails, Windows extraction dies ("could not find
# ffmpeg"), and Linux/macOS silently emit binaries named "ffmpeg\r". Force LF.
scripts/sidecar-manifest.txt text eol=lf
